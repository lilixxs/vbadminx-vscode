{
  "name": "vbaMini",
  "scopeName": "source.vbaMini",
  "fileTypes": [
    ".bas"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.vbaMini",
      "match": "(?i)\\b(Function|Optional|Private|ElseIf|Option|Public|Static|ByRef|ByVal|Until|While|Call|Else|Loop|Next|Then|Type|Wend|With|And|Dim|End|For|Let|Not|Set|Sub|As|Do|If|Or|To)\\b"
    },
    {
      "name": "string.quoted.double.vbaMini",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "'",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.vbaMini"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.vbaMini"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.vbaMini",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
