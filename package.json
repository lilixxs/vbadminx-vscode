{
  "name": "vbadminx-vscode",
  "displayName": "VBAdminx",
  "description": "%ext.description%",
  "version": "0.2.3",
  "icon": "resources/icon.png",
  "publisher": "lilixxs",
  "private": true,
  "keywords": [
    "vba",
    "vb6",
    "excel",
    "language-server",
    "com"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lilixxs/vbadminx-vscode.git"
  },
  "homepage": "https://github.com/lilixxs/vbadminx-vscode#readme",
  "bugs": {
    "url": "https://github.com/lilixxs/vbadminx-vscode/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "AI"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.bundle.js",
  "activationEvents": [
    "onLanguage:vba",
    "onLanguageModelChatProvider:vbadminx-go",
    "onView:vbadminxSymbols",
    "workspaceContains:**/vba-project.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/build.cjs",
    "typecheck": "tsc -p . --noEmit",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node scripts/test-unit.cjs",
    "test:host": "npm run compile && node scripts/test-host.cjs",
    "smoke:go": "npm run compile && node scripts/smoke-go.cjs",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --skip-license --out output/",
    "benchmark": "npm run compile && node scripts/benchmark.cjs",
    "benchmark:lsp": "npm run compile && node scripts/benchmark-server.cjs",
    "cases:vba": "npm run compile && node scripts/vba-cases.cjs",
    "capture": "npm run compile && node scripts/capture-vscode.cjs",
    "preview:form": "npm run compile && node scripts/render-form-preview.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "vba",
        "aliases": [
          "VBA"
        ],
        "extensions": [
          ".bas",
          ".cls",
          ".frm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vba",
        "scopeName": "source.vba",
        "path": "./syntaxes/vba.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vba",
        "path": "./snippets/vba.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "vba-project.json"
        ],
        "url": "./schemas/vba-project.schema.json"
      }
    ],
    "configurationDefaults": {
      "[vba]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "lilixxs.vbadminx-vscode",
        "editor.formatOnSave": false
      }
    },
    "commands": [
      {
        "command": "vbadminx.projectStatus",
        "title": "%cmd.projectStatus%"
      },
      {
        "command": "vbadminx.createProject",
        "title": "%cmd.createProject%"
      },
      {
        "command": "vbadminx.importTypeIndex",
        "title": "%cmd.importTypeIndex%"
      },
      {
        "command": "vbadminx.exportTypeIndex",
        "title": "%cmd.exportTypeIndex%"
      },
      {
        "command": "vbadminx.extractComTypeIndex",
        "title": "%cmd.extractComTypeIndex%"
      },
      {
        "command": "vbadminx.discoverCom",
        "title": "%cmd.discoverCom%"
      },
      {
        "command": "vbadminx.configureGo",
        "title": "%cmd.configureGo%"
      },
      {
        "command": "vbadminx.clearGoKey",
        "title": "%cmd.clearGoKey%"
      },
      {
        "command": "vbadminx.testGo",
        "title": "%cmd.testGo%"
      },
      {
        "command": "vbadminx.previewContext",
        "title": "%cmd.previewContext%"
      },
      {
        "command": "vbadminx.refreshSymbols",
        "title": "%cmd.refreshSymbols%",
        "icon": "$(refresh)"
      },
      {
        "command": "vbadminx.symbolsOptions",
        "title": "%cmd.symbolsOptions%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "vbadminx.symbolsGoto",
        "title": "%cmd.symbolsGoto%"
      },
      {
        "command": "vbadminx.symbolsFindReferences",
        "title": "%cmd.symbolsFindReferences%"
      },
      {
        "command": "vbadminx.symbolsRename",
        "title": "%cmd.symbolsRename%"
      },
      {
        "command": "vbadminx.workspaceSymbols",
        "title": "%cmd.workspaceSymbols%"
      },
      {
        "command": "vbadminx.focusSymbols",
        "title": "%cmd.focusSymbols%"
      },
      {
        "command": "vbadminx.openSettings",
        "title": "%cmd.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vbadminx.editSnippets",
        "title": "%cmd.editSnippets%"
      },
      {
        "command": "vbadminx.previewForm",
        "title": "%cmd.previewForm%",
        "icon": "$(preview)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vbadminxSymbols",
          "name": "%view.symbols.name%",
          "contextualTitle": "%view.symbols.name%",
          "icon": "$(symbol-method)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vbadminx.refreshSymbols",
          "when": "view == vbadminxSymbols",
          "group": "navigation@1"
        },
        {
          "command": "vbadminx.symbolsOptions",
          "when": "view == vbadminxSymbols",
          "group": "navigation@2"
        },
        {
          "command": "vbadminx.openSettings",
          "when": "view == vbadminxSymbols",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "vbadminx.previewForm",
          "when": "resourceExtname == .frm",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vbadminx.symbolsFindReferences",
          "when": "view == vbadminxSymbols && viewItem == symbol",
          "group": "1_actions"
        },
        {
          "command": "vbadminx.symbolsRename",
          "when": "view == vbadminxSymbols && viewItem == symbol",
          "group": "1_actions"
        }
      ]
    },
    "configuration": {
      "title": "VBAdminx",
      "properties": {
        "vbadminx.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn",
            "zh-tw",
            "ja",
            "ko"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.zh-cn%",
            "%config.language.enum.zh-tw%",
            "%config.language.enum.ja%",
            "%config.language.enum.ko%"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%config.language.description%"
        },
        "vbadminx.format.keywordCase": {
          "type": "boolean",
          "default": true,
          "description": "%config.format.keywordCase%"
        },
        "vbadminx.format.lineWrap": {
          "type": "boolean",
          "default": false,
          "description": "%config.format.lineWrap%"
        },
        "vbadminx.format.reorderDeclarations": {
          "type": "boolean",
          "default": false,
          "description": "%config.format.reorderDeclarations%"
        },
        "vbadminx.format.formatDesign": {
          "type": "boolean",
          "default": false,
          "description": "%config.format.formatDesign%"
        },
        "vbadminx.diagnostics.missingInformation": {
          "type": "string",
          "enum": [
            "information",
            "hint",
            "off"
          ],
          "default": "information",
          "description": "%config.diagnostics.missingInformation%"
        },
        "vbadminx.diagnostics.nameCase": {
          "type": "boolean",
          "default": true,
          "description": "%config.diagnostics.nameCase%"
        },
        "vbadminx.snippets.customPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.snippets.customPath%"
        },
        "vbadminx.com.softwareList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Excel",
            "Word",
            "PowerPoint",
            "Outlook",
            "Access",
            "Office",
            "ADODB",
            "Scripting",
            "MSXML2",
            "VBScript",
            "WScript",
            "Shell",
            "DAO"
          ],
          "scope": "application",
          "description": "%config.com.softwareList%"
        },
        "vbadminx.go.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.go.enabled%"
        },
        "vbadminx.go.connection": {
          "type": "string",
          "enum": [
            "magpie",
            "direct"
          ],
          "default": "magpie",
          "scope": "application",
          "description": "%config.go.connection%"
        },
        "vbadminx.go.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3425/v1",
          "scope": "application",
          "description": "%config.go.baseUrl%"
        },
        "vbadminx.go.model": {
          "type": "string",
          "default": "opencode-go/deepseek-v4.1-flash",
          "scope": "application",
          "description": "%config.go.model%"
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "vbadminx-go",
        "displayName": "VBAdminx · OpenCode Go",
        "managementCommand": "vbadminx.configureGo"
      }
    ],
    "languageModelTools": [
      {
        "name": "get_vba_context",
        "displayName": "%tool.context.displayName%",
        "toolReferenceName": "vbaContext",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-code)",
        "when": "isWorkspaceTrusted",
        "userDescription": "%tool.context.userDescription%",
        "modelDescription": "Read VBA context from the active document in the current workspace. Return selected code, diagnostics, project symbols, or resolved references. It does not modify files. Use selection mode only after the user selects code.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "selection",
                "diagnostics",
                "symbols",
                "references"
              ],
              "description": "Read selected code, diagnostics, project symbols, or references at the active cursor."
            },
            "query": {
              "type": "string",
              "description": "Optional symbol name filter for symbols mode."
            }
          },
          "required": [
            "mode"
          ]
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.104.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "langium": "^4.4.0",
    "langium-cli": "^4.4.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
